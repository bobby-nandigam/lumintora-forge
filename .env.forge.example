# Copy to ".env" (next to docker-compose.forge.yml), fill in, then:
#   docker compose -f docker-compose.forge.yml up --build -d
# Docker Compose auto-loads .env. Do NOT commit your real .env.

# ── Google Sign-In (real OAuth) ─────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#   Application type: Web application
#   Authorized redirect URI:  http://localhost:8080/api/v1/auth/google/callback
#   Authorized JS origin:     http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
# Set to false once real Google creds above are filled in.
ALLOW_DEV_GOOGLE=true

# ── Email for forgot-password ───────────────────────────────────────────
# Option A (recommended) — Resend: https://resend.com → API Keys.
# For quick testing you can send FROM onboarding@resend.dev with no domain setup.
RESEND_API_KEY=
EMAIL_FROM=Lumintora <onboarding@resend.dev>

# Option B — SMTP (e.g. Gmail: enable 2FA, then create an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
