# ── Database ─────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=lumintora
DB_PASSWORD=lumintora_secret
DB_NAME=lumintora

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=change_this_in_production

# ── AI — Cloudflare Worker (Llama 3.3 70B) ──────────────────────
# Deploy/iterate the worker: cd cloudflare-worker && wrangler deploy
CF_AI_URL=https://lumintora-ai.bobbynandigam-official.workers.dev

# ── Code execution (python3, java, c, c++) ───────────────────────
# Default: public Wandbox — override with a self-hosted instance in prod.
CODE_EXEC_URL=https://wandbox.org

# ── Docker / networking ──────────────────────────────────────────
# Port the frontend (nginx) is exposed on.
APP_PORT=3000

# CORS origin for direct backend access (curl / Postman).
# In Docker, nginx proxies /api so the browser never hits this.
CORS_ORIGIN=http://localhost:3000

# ── Frontend build ───────────────────────────────────────────────
# Leave empty in Docker — nginx proxies /api to the backend (same origin).
# Set to a full URL only when API and frontend are on separate hosts.
VITE_API_URL=
